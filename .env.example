# Database
# Change the port if 5432 is already used by something else on your machine.
DATABASE_URL="postgresql://pos_user:pos123@localhost:5432/pos_ordering_system?schema=public"

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Features
NEXT_PUBLIC_ENABLE_REALTIME="false"

# How long a customer's table session stays alive after scanning the QR code.
SESSION_TIMEOUT_MINUTES=3
