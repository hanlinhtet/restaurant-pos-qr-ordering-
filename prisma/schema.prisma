generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  KITCHEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  QR_PAYMENT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum TableStatus {
  FREE
  CHECKING
  ORDERING
}

enum UnitOfMeasure {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
  PACK
  TEASPOON
  TABLESPOON
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

model User {
  id         String         @id @default(cuid())
  email      String         @unique
  name       String?
  password   String
  role       UserRole       @default(STAFF)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  businesses BusinessUser[]
}

model Business {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  logo           String?
  website        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          BusinessUser[]
  branches       Branch[]
  categories     Category[]
  inventoryCategories InventoryCategory[]
  products       Product[]
  inventoryItems InventoryItem[]
}

model BusinessUser {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}

enum ServiceType {
  SELF_SERVICE
  WAITER_SERVICE
}

model Branch {
  id             String          @id @default(cuid())
  name           String
  address        String?
  phone          String?
  serviceType    ServiceType     @default(WAITER_SERVICE)
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tables         Table[]
  orders         Order[]
  cashQueue      CashQueue[]
  inventoryItems InventoryItem[]

  @@index([businessId])
}

model Category {
  id         String    @id @default(cuid())
  name       String
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId])
}

model InventoryCategory {
  id             String          @id @default(cuid())
  name           String
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id])
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([businessId])
}

model Product {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  recipeInstructions String?
  price              Decimal?           @db.Decimal(10, 2)
  image              String?
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  businessId         String
  business           Business           @relation(fields: [businessId], references: [id])
  variants           ProductVariant[]
  attributes         ProductAttribute[]
  flavours           InventoryItem[]    @relation("ProductFlavours")
  orderItems         OrderItem[]
  recipeItems        RecipeItem[]
  applyAttribute     Boolean            @default(false)
  applyPortion       Boolean            @default(false)
  isAvailable        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([businessId])
  @@index([categoryId])
}

model ProductAttribute {
  id          String      @id @default(cuid())
  name        String
  content     String?
  price       Decimal     @default(0) @db.Decimal(10, 2)
  disable     Boolean     @default(false)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  flavourItemId String?
  inventoryItem InventoryItem? @relation(fields: [flavourItemId], references: [id])
  recipeItems RecipeItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([productId])
  @@index([flavourItemId])
}

model ProductVariant {
  id          String      @id @default(cuid())
  name        String
  price       Decimal     @db.Decimal(10, 2)
  portion     Int?
  flavour     String?
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  isAvailable Boolean     @default(true)

  @@index([productId])
}

model InventoryItem {
  id            String                 @id @default(cuid())
  name          String
  sku           String?
  image         String?
  unit          UnitOfMeasure
  stockAmount   Decimal                @default(0) @db.Decimal(12, 3)
  minStockLevel Decimal?               @db.Decimal(12, 3)
  costPerUnit   Decimal?               @db.Decimal(10, 2)
  
  inventoryCategoryId String?
  inventoryCategory   InventoryCategory?     @relation(fields: [inventoryCategoryId], references: [id])
  
  businessId    String
  business      Business               @relation(fields: [businessId], references: [id])
  branchId      String
  branch        Branch                 @relation(fields: [branchId], references: [id])
  recipeItems   RecipeItem[]
  transactions  InventoryTransaction[]
  conversions   UnitConversion[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  
  flavouredAttributes ProductAttribute[]
  productsAsFlavour   Product[]          @relation("ProductFlavours")

  @@index([businessId])
  @@index([branchId])
  @@index([inventoryCategoryId])
}

model RecipeItem {
  id              String            @id @default(cuid())
  productId       String?
  product         Product?          @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])
  attributeId     String?
  attribute       ProductAttribute? @relation(fields: [attributeId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal           @db.Decimal(12, 3)
  unit            UnitOfMeasure

  @@index([productId])
  @@index([variantId])
  @@index([attributeId])
  @@index([inventoryItemId])
}

model UnitConversion {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  unit            UnitOfMeasure
  factor          Decimal       @db.Decimal(12, 6) // Conversion to base unit: 1 {unit} = {factor} {baseUnit}

  @@index([inventoryItemId])
}

model InventoryTransaction {
  id              String                 @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  type            InventoryTransactionType
  quantity        Decimal                @db.Decimal(12, 3)
  reason          String?
  orderId         String?
  createdAt       DateTime               @default(now())

  @@index([inventoryItemId])
}


model Table {
  id        String         @id @default(cuid())
  number    String
  capacity  Int
  status    TableStatus    @default(FREE)
  positionX Int            @default(0)
  positionY Int            @default(0)
  qrCode    String?
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id])
  sessions  TableSession[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([branchId])
}

model TableSession {
  id           String    @id @default(cuid())
  tableId      String
  table        Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  active       Boolean   @default(true)
  lastActivity DateTime  @default(now())
  endedAt      DateTime?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tableId])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  status         OrderStatus    @default(PENDING)
  type           OrderType      @default(DINE_IN)
  totalAmount    Decimal        @db.Decimal(10, 2)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  tableSessionId String?
  tableSession   TableSession?   @relation(fields: [tableSessionId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  kitchenTickets KitchenTicket[]
  report         OrderReport?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId])
  @@index([tableSessionId])
}

model OrderReport {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String
  description String?
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant?   @relation(fields: [variantId], references: [id])
  attributeId String?
  attribute   ProductAttribute? @relation(fields: [attributeId], references: [id])
  quantity    Int
  unitPrice   Decimal           @db.Decimal(10, 2)
  subtotal    Decimal           @db.Decimal(10, 2)
  notes       String?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([attributeId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
}

model KitchenTicket {
  id        String      @id @default(cuid())
  orderId   String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(PREPARING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([orderId])
}

model CashQueue {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  orderId   String
  called    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}
